module MiniAgent
  VERSION: String

  type json_object = Hash[String, untyped]
  type message = Hash[Symbol, untyped]
  type tool_call = Hash[String, untyped]

  class Error < StandardError
  end

  class TimeoutError < Error
  end

  class LLMError < Error
  end

  class ConfigError < Error
  end

  module Messages
    SYSTEM_PROMPT: String
    ENVIRONMENT: String
    STOP_MAX_TURNS: String
    EXIT_CODE_PATTERN: Regexp

    # Строки, уходящие результатом инструмента в модель, а не в терминал.
    module Tool
    end
  end

  module Color
    CODES: Hash[Symbol, String]
    RESET: String

    def self.paint: (untyped text, *Symbol styles, ?enabled: bool) -> String
    def self.red: (untyped text, ?enabled: bool) -> String
    def self.green: (untyped text, ?enabled: bool) -> String
    def self.yellow: (untyped text, ?enabled: bool) -> String
    def self.blue: (untyped text, ?enabled: bool) -> String
    def self.cyan: (untyped text, ?enabled: bool) -> String
    def self.gray: (untyped text, ?enabled: bool) -> String
    def self.bold: (untyped text, ?enabled: bool) -> String
  end

  module Paths
    def self.directory: (untyped value) -> String?
    def self.file: (untyped value) -> String?
    def self.expand: (untyped value) -> String?
  end

  class Config
    DEFAULTS: Hash[Symbol, untyped]
    ENV_KEYS: Hash[Symbol, String]
    WINDOW_SHARE: Float

    attr_reader base_url: String
    attr_reader api_key: String
    attr_reader model: String
    attr_reader max_turns: Integer
    attr_reader retry_count: Integer
    attr_reader retry_delay: Float
    attr_reader timeout: Float
    attr_reader llm_timeout: Float
    attr_reader policy: Symbol
    attr_accessor context_window: Integer?

    def initialize: (?Hash[Symbol, untyped] options, ?env: Hash[String, String]) -> void
    def max_tokens: () -> Integer
    def allow_unsafe?: () -> bool
    def plan?: () -> bool
    def stream?: () -> bool
    def auto_compact?: () -> bool
    def chat_uri: () -> URI::Generic
    def models_uri: () -> URI::Generic
    def cwd: () -> String?
    def log: () -> String?
    def use_ssl?: () -> bool
  end

  class ProjectContext
    FILENAMES: Array[String]
    MAX_SIZE: Integer

    def self.load: (?String dir) -> String?
    def initialize: (?String dir) -> void
    def load: () -> String?
    def filename: () -> String?
  end

  class Usage
    attr_reader sent: Integer
    attr_reader generated: Integer
    attr_reader context: Integer
    attr_reader requests: Integer

    def initialize: () -> void
    def add: (json_object? usage) -> self
    def reset_context: () -> self
    def empty?: () -> bool
    def to_h: () -> Hash[Symbol, Integer]
  end

  class Transcript
    def initialize: (String path, ?ui: UI?, ?clock: untyped) -> void
    def path: () -> String
    def session: (Config config) -> void
    def message: (message) -> void
    def reasoning: (String? text) -> void
    def rollback: (Integer count) -> void
    def compact: (before: Integer) -> void
    def close: () -> void
  end

  class History
    attr_accessor project_context: String?
    attr_reader transcript: Transcript?
    attr_reader usage: Usage

    def initialize: (?project_context: String?, ?transcript: Transcript?, ?cwd: String?) -> void
    def build: () -> Conversation
  end

  class Conversation
    def initialize: (?system_prompt: String?, ?project_context: String?, ?transcript: Transcript?, ?cwd: String?) -> void
    def system: (String content) -> message
    def user: (String content) -> message
    def assistant: (String? content, ?tool_calls: Array[tool_call]?, ?usage: json_object?) -> message
    def tool: (String tool_call_id, String content) -> message
    def to_a: () -> Array[message]
    def last: () -> message?
    def size: () -> Integer
    def empty?: () -> bool
    def mark: () -> Integer
    def rollback: (Integer mark) -> Integer
    def project_context_size: () -> Integer
    def self.tool_call_id: (tool_call) -> String
  end

  module Plural
    def self.form: (Integer count, String one, String few, String many) -> String
    def self.with: (Integer count, String one, String few, String many) -> String
  end

  class Window
    WARN_AT: Float

    attr_reader size: Integer?
    attr_reader max_tokens: Integer

    def initialize: (size: Integer?, ?prompt_tokens: Integer?, ?max_tokens: Integer) -> void
    def known?: () -> bool
    def measurable?: () -> bool
    def prompt_tokens: () -> Integer
    def occupied: () -> Integer
    def percent: () -> Integer
    def free: () -> Integer?
    def remaining: () -> Integer
    def tight?: () -> bool
    def starved?: () -> bool
  end

  class ContextReport
    type category = :system | :project | :tasks | :answers | :tools

    CATEGORIES: Array[category]

    def initialize: (Conversation conversation, ?usage: Usage?, ?config: Config?) -> void
    def sizes: () -> Hash[category, Integer]
    def messages: () -> Integer
    def total: () -> Integer
    def empty?: () -> bool
    def share: (category) -> Integer
    def fixed: () -> Integer
    def compactable: () -> Integer
    def project_dominates?: () -> bool
    def tokens: () -> Integer?
    def window: () -> Window
  end

  class ContextView
    def initialize: (UI ui) -> void
    def call: (ContextReport report) -> void
  end

  class Compactor
    def initialize: (client: LLMClient, history: History, ui: UI, ?usage: Usage?) -> void
    def call: (Conversation conversation) -> Conversation
  end

  class AutoCompactor
    MIN_GAIN: Float

    def initialize: (compactor: Compactor, config: Config, ui: UI, ?usage: Usage?) -> void
    def call: (Conversation conversation) -> Conversation
  end

  class Initializer
    def initialize: (agent: Agent, config: Config, ui: UI, ?prompt: Prompt?) -> void
    def call: (Conversation conversation) -> Conversation
  end

  class Planner
    def initialize: (agent: Agent, plan_mode: PlanMode, ui: UI, ?prompt: Prompt?) -> void
    def call: (String task, Conversation conversation) -> Conversation
  end

  class ProcessRunner
    class Result < Struct[untyped]
      attr_accessor stdout: String
      attr_accessor stderr: String
      attr_accessor exit_code: Integer
      def success?: () -> bool
    end

    attr_reader timeout: Numeric
    attr_reader cwd: String?

    def initialize: (?timeout: Numeric, ?poll_interval: Numeric, ?cwd: String?) -> void
    def call: (String command) -> Result
  end

  class Prompt
    def initialize: (?input: IO, ?output: IO) -> void
    def confirm?: (String question) -> bool

    class AutoApprove
      def confirm?: (String question) -> bool
    end

    class AutoDeny
      def confirm?: (String question) -> bool
    end
  end

  module ReadOnly
    COMMANDS: Array[String]
    GIT_SUBCOMMANDS: Array[String]
    UNPARSEABLE: Regexp
    SEPARATORS: Regexp

    def self.command?: (String? command) -> bool
  end

  class PlanMode
    attr_accessor plan: String?

    def initialize: (?enabled: bool) -> void
    def on?: () -> bool
    def enable: () -> self
    def disable: () -> self
    def allows?: (String command) -> bool
  end

  class CommandGuard
    type verdict = :allow | :cancelled | :planning

    DANGEROUS_PATTERNS: Array[Regexp]
    POLICIES: Array[Symbol]

    def initialize: (?policy: Symbol, ?prompt: untyped, ?ui: UI?, ?plan_mode: PlanMode) -> void
    def self.dangerous?: (String command) -> bool
    def verdict: (String command) -> verdict
  end

  module Tools
    class Bash
      NAME: String
      SCHEMA: json_object

      def initialize: (guard: CommandGuard, runner: ProcessRunner) -> void
      def name: () -> String
      def schema: () -> json_object
      def call: (json_object arguments) -> String
    end
  end

  class ToolRegistry
    def initialize: (?Array[untyped] tools) -> void
    def register: (untyped tool) -> self
    def schemas: () -> Array[json_object]
    def names: () -> Array[String]
    def empty?: () -> bool
    def dispatch: (String name, json_object arguments) -> String
  end

  class UI
    PREVIEW_LINES: Integer
    PREVIEW_CHARS: Integer
    COMMAND_LINES: Integer
    COMMAND_CHARS: Integer
    BULLET: String
    BRANCH: String
    INDENT: String
    SPINNER_INTERVAL: Float

    def initialize: (?out: IO, ?tty: bool?, ?spinner_interval: Numeric, ?spinner_width: Integer?) -> void
    def tty?: () -> bool
    def status=: (String? text) -> void
    def progress=: (String? text) -> void
    def ticker=: (String? text) -> void
    def stream_chunk: (String text) -> void
    def stream_finish: () -> void
    def stop_spinner: () -> void
    def puts: (?untyped text) -> void
    def print: (untyped text) -> void
    def assistant: (String content) -> void
    def context: (ContextReport report) -> void
    def paint: (untyped text, *Symbol styles) -> String
    def models: (Array[String] names, selected: String, url: String) -> void
    def warn: (String text) -> void
    def error: (String text) -> void
    def tool_call: (String name, json_object arguments) -> void
    def tool_result: (String result) -> void
    def with_spinner: [T] () { () -> T } -> T
  end

  class Spinner
    FRAMES: Array[String]
    INTERVAL: Float
    DEFAULT_WIDTH: Integer
    MIN_TICKER: Integer
    TICKER_SEPARATOR: String

    attr_writer status: String?
    attr_writer progress: String?
    attr_writer ticker: String?

    def initialize: (ui: UI, ?enabled: bool, ?interval: Numeric, ?width: Integer?) -> void
    def around: [T] () { () -> T } -> T
    def stop: () -> void
  end

  class ChatPayload
    TEMPERATURE: Float

    def initialize: (config: Config, messages: Array[message], ?tools: Array[json_object], ?tool_choice: String) -> void
    def to_json: (*untyped) -> String
  end

  class StreamParser
    DATA_PREFIX: String
    DONE: String
    TAIL_LIMIT: Integer

    attr_reader usage: json_object?
    attr_reader finish_reason: String?
    attr_reader reasoning: String

    def initialize: () ?{ (String) -> void } -> void
    def feed: (String chunk) -> void
    def reasoning_length: () -> Integer
    def reasoning_tail: () -> String
    def content: () -> String
    def tool_calls: () -> Array[tool_call]
    def empty?: () -> bool
    def to_a: () -> [String, Array[tool_call], json_object?, String?]
  end

  class StreamRequest
    def initialize: (http: untyped, ?ui: UI?, ?visible: bool) -> void
    def call: (untyped request) -> [untyped, StreamParser]
  end

  class ErrorResponse
    RETRIABLE_STATUS: Array[Integer]
    MAX_RETRY_AFTER: Integer

    def initialize: (untyped response) -> void
    def code: () -> String
    def retriable?: () -> bool
    def retry_after: () -> Float?
    def text: () -> String
    def to_s: () -> String
  end

  class ModelsRequest
    INVALID_DATA: String

    def initialize: (config: Config, http: untyped) -> void
    def call: () -> Array[String]
  end

  class WindowProbe
    PATH: String
    TIMEOUT: Integer

    def initialize: (config: Config) -> void
    def call: () -> Integer?
  end

  class ChatResponse
    TRUNCATED: String

    def self.parse: (String body) -> [ChatResponse?, String?]
    def initialize: (json_object data, json_object message) -> void
    def content: () -> String
    def tool_calls: () -> Array[tool_call]
    def reasoning: () -> String
    def usage: () -> json_object?
    def finish_reason: () -> String?
    def truncated?: () -> bool
    def to_a: () -> [String, Array[tool_call], json_object?, String?]
  end

  class LLMClient
    RETRIABLE: Array[Class]
    OPEN_TIMEOUT: Integer

    def initialize: (config: Config, ?ui: UI?, ?sleeper: untyped, ?transcript: Transcript?) -> void
    def start: [T] () { (LLMClient) -> T } -> T
    def chat: (Array[message] messages, ?tools: Array[json_object], ?tool_choice: String, ?visible: bool) -> [String, Array[tool_call], json_object?, String?]
    def models: () -> Array[String]
  end

  class ToolCallRunner
    MAX_TOOL_OUTPUT: Integer
    REPEAT_LIMIT: Integer
    LOOP_LIMIT: Integer

    type status = :ok | :loop

    def initialize: (tools: ToolRegistry, ui: UI) -> void
    def reset: () -> void
    def call: (Conversation conversation, tool_call tool_call) -> status
  end

  class Agent
    type outcome = :ok | :failed | :unfinished

    attr_reader outcome: outcome
    attr_reader answer: String?
    attr_reader plan_mode: PlanMode

    def initialize: (config: Config, client: LLMClient, tools: ToolRegistry, ui: UI, ?history: History, ?prompt: Prompt?, ?auto_compactor: AutoCompactor?, ?plan_mode: PlanMode) -> void
    def new_conversation: () -> Conversation
    def compact: (Conversation conversation) -> Conversation
    def init: (Conversation conversation) -> Conversation
    def plan: (String task, Conversation conversation) -> Conversation
    def run: (?String? user_message, ?conversation: Conversation?) -> Conversation
    def failed?: () -> bool
    def usage: () -> Usage
  end

  class AgentBuilder
    def initialize: (config: Config, ui: UI, ?input: IO, ?output: IO) -> void
    def call: [T] () { (Agent, ToolRegistry) -> T } -> T
  end

  class LineReader
    def initialize: (?input: IO, ?output: IO) -> void
    def interactive?: () -> bool
    def gets: (String prompt) -> String?
  end

  class SlashCommands
    # Команды, меняющие состояние сессии: исполняет их Repl, а не сами команды.
    type verdict = :clear | :compact | :init | :plan | :exit

    PATTERN: Regexp
    BARE_EXIT: Array[String]
    COMMANDS: Hash[String, String]
    VERDICTS: Hash[String, verdict]

    def initialize: (config: Config, tools: ToolRegistry, ui: UI, ?usage: Usage) -> void
    def call: (String? line, ?conversation: Conversation?) -> (:task | :handled | verdict)
  end

  class Repl
    def initialize: (agent: Agent, config: Config, tools: ToolRegistry, ui: UI, ?reader: LineReader?) -> void
    def run: () -> Conversation
  end

  class ModelsCommand
    def initialize: (config: Config, ui: UI) -> void
    def call: () -> Integer
  end

  class CLI
    EXIT_OK: Integer
    EXIT_USAGE: Integer
    EXIT_CONNECT: Integer
    EXIT_LLM: Integer
    EXIT_UNFINISHED: Integer
    EXIT_CODES: Hash[Symbol, Integer]
    FLAGS: Array[Array[untyped]]
    CONNECT_ERRORS: Array[Class]

    def self.start: (Array[String] argv, ?out: IO, ?input: IO) -> Integer
    def initialize: (?out: IO, ?input: IO) -> void
    def start: (Array[String] argv) -> Integer
  end
end
